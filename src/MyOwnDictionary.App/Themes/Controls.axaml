<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock.title">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.topbar">
        <Setter Property="Foreground" Value="{DynamicResource TopBarTextBrush}"/>
    </Style>

    <Style Selector="TextBlock.card-title">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.welcome">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="TextBlock.stat">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.stat.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="TextBlock.stat.lime">
        <Setter Property="Foreground" Value="{DynamicResource LimeBrush}"/>
    </Style>

    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="1.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BoxShadow" Value="0 2 8 0 #14000000"/>
    </Style>

    <Style Selector="Border.card:light">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Border.row">
        <Setter Property="Background" Value="{DynamicResource RowBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource ThemeBrush}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.chip.google">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.chip.saved">
        <Setter Property="Background" Value="{DynamicResource LimeBrush}"/>
    </Style>

    <Style Selector="Border.chip TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.chip.saved TextBlock">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource NavLinkBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="Button.nav:pointerover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.nav.active">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeBrush}"/>
    </Style>

    <Style Selector="Button.nav.active:pointerover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeHoverBrush}"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource ThemeBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource RowBrush}"/>
    </Style>

    <Style Selector="Button.swap">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.swap:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
    </Style>

    <Style Selector="Button.icon.topbar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TopBarTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TopBarTextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.icon.topbar:pointerover">
        <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.tiny">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Button.tiny:pointerover">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.tiny.danger:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style Selector="TextBox.editor">
        <Setter Property="MinHeight" Value="168"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
    </Style>

    <Style Selector="TextBox.search">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    </Style>

    <Style Selector="TextBox.field">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    </Style>

    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0,0,0,8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBox.plain ListBoxItem:focus /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector=".phone-only" x:SetterTargetType="Control">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="UserControl.phone .phone-only" x:SetterTargetType="Control">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="UserControl.phone .desktop-only" x:SetterTargetType="Control">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="UserControl.phone TextBlock.title">
        <Setter Property="FontSize" Value="22"/>
    </Style>
    <Style Selector="UserControl.phone TextBlock.welcome">
        <Setter Property="FontSize" Value="22"/>
    </Style>
    <Style Selector="UserControl.phone TextBlock.stat">
        <Setter Property="FontSize" Value="24"/>
    </Style>
    <Style Selector="UserControl.phone TextBox.editor">
        <Setter Property="MinHeight" Value="112"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="UserControl.phone UniformGrid.choices">
        <Setter Property="Columns" Value="1"/>
    </Style>
    <Style Selector="UserControl.phone Border.card">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.tabbar">
        <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
        <Setter Property="Padding" Value="6,8,6,10"/>
    </Style>
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,6"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Button.tab.active">
        <Setter Property="Background" Value="{DynamicResource ThemeBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
</Styles>
