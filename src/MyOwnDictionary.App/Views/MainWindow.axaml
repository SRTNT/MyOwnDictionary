<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyOwnDictionary.App.ViewModels"
        xmlns:views="using:MyOwnDictionary.App.Views"
        x:Class="MyOwnDictionary.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MyOwnDictionary"
        Icon="avares://MyOwnDictionary/Assets/Icons/app-icon.png"
        Width="1280"
        Height="840"
        MinWidth="1080"
        MinHeight="700"
        Background="{DynamicResource WindowBackgroundBrush}">
    <views:MainView/>
</Window>
